# Шаблон переменных окружения. Скопируйте в .env и заполните значения.
# Файл .env добавлен в .gitignore и в репозиторий не попадает.

# --- Telegram ---
# Токен от @BotFather. Нужен для запуска бота (Этап 2 и далее).
TELEGRAM_BOT_TOKEN=

# --- LLM (OpenAI-совместимый эндпоинт) ---
# Пример: https://api.deepseek.com/v1, https://openrouter.ai/api/v1
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# --- Obsidian Local REST API ---
# Порт 27123 — HTTP, 27124 — HTTPS (по умолчанию в плагине).
OBSIDIAN_BASE_URL=http://127.0.0.1:27123
OBSIDIAN_API_KEY=

# --- Безопасность ---
# true  = ничего не записываем в vault, только читаем и логируем (по умолчанию)
# false = разрешаем реальную запись в vault
OBSIDIAN_DRY_RUN=true

# --- Агент (Этапы 5–7; сейчас код эти переменные не читает) ---
# auto   = спрашивать только при неоднозначности (по умолчанию)
# always = спрашивать перед любой записью
# never  = не спрашивать (опасно)
# AGENT_CONFIRMATION=auto
# AGENT_DEFAULT_FOLDER=Inbox
# AGENT_AUTO_FOLDER=true
# AGENT_AUTO_LINK=true
# AGENT_SEARCH_LIMIT=5
# AGENT_LINK_LIMIT=10

# --- Логирование ---
# DEBUG / INFO / WARNING / ERROR / CRITICAL
LOG_LEVEL=INFO
