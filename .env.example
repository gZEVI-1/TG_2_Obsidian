# Шаблон переменных окружения. Скопируйте в .env и заполните значения.
# Файл .env добавлен в .gitignore и в репозиторий не попадает.
#
# Порядок разделов повторяет рабочий .env: хранилище, Telegram, LLM, копии.
# Ниже — настройки, которых в рабочем .env может не быть: подключение REST,
# агент, RAG, аудит и логи. Их можно оставить закомментированными.

# --- Режим хранилища ---
# auto  = сначала REST API, при недоступности — файлы vault (по умолчанию);
#         нужны и OBSIDIAN_API_KEY, и OBSIDIAN_VAULT_PATH, иначе резерва нет
# rest  = только Local REST API: Obsidian должен быть запущен, нужен ключ
# vault = только файлы .md напрямую: Obsidian может быть закрыт, ключ не нужен
OBSIDIAN_MODE=auto

# Ключ плагина Local REST API. Нужен для rest и для REST-пути в auto.
# Утёк — перегенерируйте в настройках плагина.
OBSIDIAN_API_KEY=

# Путь к папке vault. Нужен для vault и для резерва в auto.
# Пример: OBSIDIAN_VAULT_PATH=E:\FOLDER\TG-OBS\TG-OBS-vault-test
# В Docker путь внутри контейнера задаёт docker-compose.yml.
OBSIDIAN_VAULT_PATH=

# --- Безопасность записи ---
# true  = ничего не записываем в vault, только читаем и логируем (по умолчанию)
# false = разрешаем реальную запись в vault
OBSIDIAN_DRY_RUN=true

# --- Telegram Bot ---
# Токен от @BotFather. Нужен для запуска бота.
TELEGRAM_BOT_TOKEN=
# Кто может пользоваться ботом: числовые id через запятую (не username).
# Свой id покажет @userinfobot. Пусто = отвечать любому чату (небезопасно).
# TELEGRAM_ALLOWED_USERS=123456789

# --- LLM: режим заглушек, пока не добавлены реальные аккаунты ---
# true  = сеть и ключи не нужны, но заметки не создаются (заглушка не
#         вызывает инструменты). Подходит только для проверки.
# false = реальная работа: заполните хотя бы один аккаунт LLM_API_<N>_* ниже.
LLM_STUB=true
# Сколько API-заглушек имитировать (1–20).
LLM_STUB_ACCOUNTS=3
# Запросов на пару «модель — аккаунт» до ответа 429.
LLM_STUB_QUOTA=2
# Через сколько секунд квота и пул сбрасываются к началу.
LLM_STUB_RESET_SECONDS=60

# Заметка-описание стиля: тон, структура, оформление (Этап 6).
# Путь от корня хранилища. Пусто — стиль не задан.
# AGENT_STYLE_NOTE=Templates/Мой стиль.md

# Порядок = качество: первая модель лучшая, дальше — запасные.
# Это же значение можно оставить при переходе на реальные API.
LLM_MODELS=nvidia/nemotron-3-ultra-550b-a55b:free,deepseek/deepseek-r1:free,qwen/qwen3-235b-a22b:free,google/gemma-4-31b-it:free

# --- Реальные аккаунты (несколько API с разных аккаунтов) ---
# Нумерация с 1. У каждого аккаунта свой ключ; URL может быть общим.
# LLM_API_1_NAME=account-1
# LLM_API_1_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_1_KEY=
# LLM_API_2_NAME=account-2
# LLM_API_2_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_2_KEY=
# LLM_API_3_NAME=account-3
# LLM_API_3_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_3_KEY=

# Старый одиночный формат (поддерживается, если LLM_API_* не заданы).
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=
# LLM_MODEL=

# Через сколько секунд после 429 повторять пару, если провайдер не прислал
# Retry-After. В режиме заглушек не используется.
# LLM_COOLDOWN_SECONDS=3600

# --- Папка для резервных копий ---
# Папка вне хранилища: zip с заметками и журналом аудита. Пусто — копии
# и команда --backup отключены. В Docker путь внутри контейнера задаёт
# docker-compose.yml.
# BACKUP_DIR=E:\FOLDER\TG-OBS\backups
# Сколько последних копий хранить (1–100).
# BACKUP_KEEP=7
# Как часто делать копию, пока бот запущен: при старте, если просрочена,
# и далее проверка раз в час. 0 — только вручную командой --backup (0–720).
# BACKUP_EVERY_HOURS=24

# --- Obsidian Local REST API: подключение и повторы ---
# Порт 27123 — HTTP, 27124 — HTTPS (по умолчанию в плагине).
# Без этого блока используется http://127.0.0.1:27123 и 3 повтора.
OBSIDIAN_BASE_URL=http://127.0.0.1:27123
# Проверять сертификат HTTPS. false — только для самоподписанного сертификата
# Local REST API (порт 27124) на своём устройстве или NAS.
# OBSIDIAN_VERIFY_SSL=true
# Сколько секунд не обращаться к REST после сбоя, прежде чем проверить снова.
# OBSIDIAN_FAILOVER_SECONDS=30
# Повторы временных ошибок чтения (сеть, 429, 5xx): 1–5.
# OBSIDIAN_RETRY_ATTEMPTS=3
# Базовая пауза между повторами, секунды (0–10); дальше растёт вдвое.
# OBSIDIAN_RETRY_DELAY_SECONDS=0.5
# Журнал изменений в state/audit (append-only JSONL, без содержимого заметок).
# AUDIT_ENABLED=true

# --- Агент, папки и связи ---
# auto   = спрашивать только при неоднозначности (по умолчанию)
# always = спрашивать перед любой записью
# never  = не спрашивать (опасно)
# AGENT_CONFIRMATION=auto
# AGENT_DEFAULT_FOLDER=Inbox
# AGENT_AUTO_FOLDER=true
# AGENT_SEARCH_LIMIT=5
# true  = при создании и правке предлагать связи с другими заметками
# AGENT_AUTO_LINK=true
# Сколько ссылок максимум предлагать одной заметке (1–50).
# AGENT_LINK_LIMIT=10
# Папка в хранилище с шаблонами заметок (.md, только верхний уровень).
# AGENT_TEMPLATE_FOLDER=Templates

# --- Семантический поиск, RAG ---
# Нужны зависимости: pip install -r requirements-rag.txt
# true  = поиск по смыслу (локальные эмбеддинги), false = только текст
# RAG_ENABLED=true
# Модель sentence-transformers; скачивается один раз (~470 МБ).
# RAG_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# Сколько заметок добавлять к результатам поиска по смыслу (1–20).
# RAG_TOP_K=5

# --- Логирование ---
# DEBUG / INFO / WARNING / ERROR / CRITICAL
LOG_LEVEL=INFO
# Файл лога: ротация на 2 МБ, хранится 5 файлов. Относительный путь — от корня
# проекта; пустое значение — писать только в консоль.
# LOG_FILE=state/logs/app.log

# --- Docker (только для docker compose, бот эти переменные не читает) ---
# Пути на хосте, которые монтируются в контейнер. По умолчанию ./vault,
# ./backups и ./state рядом с docker-compose.yml. Пишите в прямых слэшах.
# VAULT_PATH=E:/FOLDER/TG-OBS/TG-OBS-vault-test
# BACKUP_PATH=E:/FOLDER/TG-OBS/backup
# STATE_PATH=./state
# Владелец файлов на хосте: на Synology обычно 1026, на VPS — 1000.
# PUID=1000
# PGID=1000
# 1 — собрать образ с RAG (sentence-transformers), 0 — без него.
# INSTALL_RAG=0
# Часовой пояс контейнера: влияет на даты в заметках.
# TZ=Asia/Dubai
